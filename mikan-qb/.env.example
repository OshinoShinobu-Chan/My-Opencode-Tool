# 复制为 .env 并填写凭据
# .env 已被 .gitignore 排除，不会入库

# qBittorrent WebUI（必填）
QB_HOST=http://www.crimmy.top:8000
QB_USERNAME=
QB_PASSWORD=

# Mikan 站点（可选，会覆盖 config.toml 中的 mikan.base_url）
MIKAN_BASE=https://mikanani.kas.pub

# Bangumi / bgm.tv 个人令牌（可选）
# 用途：拉取每集精确放送日期，替代「开播日 + 7×集数」的估算
# 来源：https://next.bgm.tv/demo/access-token
BGM_TOKEN=

# Bangumi 需要走代理时填这里（不填则自动探测 HTTPS_PROXY / Windows 注册表）
BGM_PROXY=
